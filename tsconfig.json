/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "business": ["./dist/shared/business"],
      "ui": ["./dist/shared/ui"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/dashboard/tsconfig.app.json"
    },
    {
      "path": "./projects/dashboard/tsconfig.spec.json"
    },
    {
      "path": "./projects/inprogress/tsconfig.app.json"
    },
    {
      "path": "./projects/inprogress/tsconfig.spec.json"
    },
    {
      "path": "./projects/stocks/tsconfig.app.json"
    },
    {
      "path": "./projects/stocks/tsconfig.spec.json"
    },
    {
      "path": "./projects/history/tsconfig.app.json"
    },
    {
      "path": "./projects/history/tsconfig.spec.json"
    },
    {
      "path": "./projects/search/tsconfig.app.json"
    },
    {
      "path": "./projects/search/tsconfig.spec.json"
    },
    {
      "path": "./projects/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/business/tsconfig.lib.json"
    },
    {
      "path": "./projects/business/tsconfig.spec.json"
    }
  ]
}
