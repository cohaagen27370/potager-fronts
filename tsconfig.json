/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@business": [
        "./projects/shared/business/src/public-api.ts"
      ],
      "@ui": [
        "./projects/shared/ui/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/apps/dashboard/tsconfig.app.json"
    },
    {
      "path": "./projects/apps/dashboard/tsconfig.spec.json"
    },
    {
      "path": "./projects/apps/inprogress/tsconfig.app.json"
    },
    {
      "path": "./projects/apps/inprogress/tsconfig.spec.json"
    },
    {
      "path": "./projects/apps/stocks/tsconfig.app.json"
    },
    {
      "path": "./projects/apps/stocks/tsconfig.spec.json"
    },
    {
      "path": "./projects/apps/history/tsconfig.app.json"
    },
    {
      "path": "./projects/apps/history/tsconfig.spec.json"
    },
    {
      "path": "./projects/apps/search/tsconfig.app.json"
    },
    {
      "path": "./projects/apps/search/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/business/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/business/tsconfig.spec.json"
    }
  ]
}