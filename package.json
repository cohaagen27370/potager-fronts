{
  "name": "potager-fronts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:all": "concurrently \"npm run start:dashboard\" \"npm run start:inprogress\" \"npm run start:history\" \"npm run start:stocks\" \"npm run start:search\"",
    "build:all": "npm run build:dashboard && npm run build:inprogress && npm run build:stocks && npm run build:history && npm run build:search && npm run postbuild:all",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:test": "concurrently \"npm run start:dashboard\" \"npm run start:inprogress\"",
    "start:dashboard": "ng serve dashboard --port 4201",
    "start:inprogress": "ng serve inprogress --port 4202",
    "start:history": "ng serve history --port 4203",
    "start:stocks": "ng serve stocks --port 4204",
    "start:search": "ng serve inprogress --port 4205",
    "build:ui": "ng build ui -c production",
    "build:dashboard": "ng build dashboard --output-path=dist/dashboard -c production",
    "build:inprogress": "ng build inprogress --base-href=/inprogress/ --output-path=dist/dashboard/inprogress -c production",
    "build:stocks": "ng build stocks --base-href=/stocks/ --output-path=dist/dashboard/stocks -c production",
    "build:history": "ng build history --base-href=/history/ --output-path=dist/dashboard/history -c production",
    "build:search": "ng build search --base-href=/search/ --output-path=dist/dashboard/search -c production",
    "postbuild:all": "mkdir -p dist/dashboard/browser/inprogress && cp -r dist/dashboard/inprogress/browser/* dist/dashboard/browser/inprogress/ && mkdir -p dist/dashboard/browser/stocks && cp -r dist/dashboard/stocks/browser/* dist/dashboard/browser/stocks/ && mkdir -p dist/dashboard/browser/history && cp -r dist/dashboard/history/browser/* dist/dashboard/browser/history/ && mkdir -p dist/dashboard/browser/search && cp -r dist/dashboard/search/browser/* dist/dashboard/browser/search/"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.14.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@primeuix/themes": "^2.0.3",
    "date-fns": "^4.4.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/date-fns": "^2.5.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
